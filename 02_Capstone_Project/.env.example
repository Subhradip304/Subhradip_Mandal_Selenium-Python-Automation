# Copy this file to .env and use an existing TutorialsNinja demo account.
BASE_URL=https://tutorialsninja.com/demo/
DEMO_EMAIL=demo@gmail.com
DEMO_PASSWORD=demo-password
BROWSER=chrome
HEADLESS=false
TIMEOUT=15
# Seconds to pause after each browser action. Increase for a slower demonstration.
ACTION_DELAY=1.5
